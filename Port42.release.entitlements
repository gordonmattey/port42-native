<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>
	<key>com.apple.security.automation.apple-events</key>
	<true/>
	<!-- The hardened runtime (every notarized build) lets an app ask for the microphone or the camera
	     only when it declares these. Without them macOS never shows the prompt and supplies silence:
	     voice showed a live mic and typed nothing, in every release (GM, 2026-09-27). -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<key>com.apple.security.device.camera</key>
	<true/>
	<!-- GhosttyKit allocates executable memory at runtime (GPU/font stack);
	     Apple Silicon kills the process without these. Matches Ghostty.app.
	     Notarization permits these (Ghostty ships notarized with allow-jit).
	     No disable-library-validation (BLD-01): the only dynamically loaded code is Sparkle.framework,
	     which build.sh re-signs with the Port42 team identity, so library validation passes, and any
	     code this app loads would inherit its microphone, camera, screen and automation grants. -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
</dict>
</plist>
